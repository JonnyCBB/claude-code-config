{
  "env": {
    "CLAUDE_AFK_COUNTDOWN_MS": "2147483647",
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Search(pattern:*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(lsof *)",
      "Bash(awk *)",
      "Bash(test -f *)",
      "Bash(realpath *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git remote *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh repo view *)",
      "Bash(gh api *)",
      "Bash(gh gist create *)",
      "Bash(curl *)",
      "Bash(bazel query *)",
      "Bash(bazel info *)",
      "Bash(mkdir *)",
      "Bash(mvn *)",
      "Bash(sbt *)",
      "Bash(pytest *)",
      "Bash(tox -e *)",
      "Bash(uv run isort *)",
      "Bash(uv run black *)",
      "Bash(uv run ruff *)",
      "Bash(python3 -c *)",
      "Bash(uv run pytest *)",
      "Bash(rm -f .claude/diff-comments.json *)",
      "Bash(rm -f .claude/plan-comments.json *)",
      "Bash(CLAUDE_MODE=*)",
      "Bash(kill -9 *)",
      "Bash(kill *)",
      "Bash(renice *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(bd *)",
      "Bash(agent-deck *)",
      "Bash(crit *)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh 'Claude Code is waiting for your input'"
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/security-block.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'CMD=$(jq -r \".tool_input.command\" < /dev/stdin); if echo \"$CMD\" | grep -q \"git commit\"; then echo \"{\\\"additionalContext\\\": \\\"Before committing, ensure tests pass and code is formatted.\\\"}\"; fi'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'H=\"$HOME/.claude/hooks/preclose_guard.py\"; [ -r \"$H\" ] || exit 0; exec python3 \"$H\"'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context.sh"
          },
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh 'Claude Code has stopped'"
          },
          {
            "type": "command",
            "command": "AGENTDECK_STOP_SYNC=1 agent-deck hook-handler"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/comms-contract-check.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent-deck hook-handler",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "agent-deck@agent-deck": true,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "crit@crit": true,
    "eng-utils@jbb-claude-code-plugins": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "jiffy-toolkit@jbb-claude-code-plugins": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "jbb-feature-dev@jbb-claude-code-plugins": true,
    "spec-workflow@ky1ejs-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "weaviate@weaviate-plugins": true
  },
  "extraKnownMarketplaces": {
    "agent-deck": {
      "source": {
        "source": "github",
        "repo": "asheshgoplani/agent-deck"
      },
      "autoUpdate": true
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      },
      "autoUpdate": true
    },
    "ky1ejs-plugins": {
      "source": {
        "source": "github",
        "repo": "ky1ejs/claude-plugins"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "jbb-claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/JonnyCBB/claude-code-config.git"
      },
      "autoUpdate": true
    },
    "weaviate-plugins": {
      "source": {
        "source": "github",
        "repo": "weaviate/agent-skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "low"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
